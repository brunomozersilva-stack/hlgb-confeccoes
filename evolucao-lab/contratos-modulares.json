  "createdAt": "2026-11-14",
  "implementation": false,
  "appliesToProduction": false,
  "databaseAccess": false,
  "principles": [
    "As telas não escrevem diretamente tabelas; todo comando passa por um núcleo autenticado.",
    "O núcleo de gravação, autenticação, controle de revisão e WAL é protegido e não pode ser desligado durante operações.",
    "Desativar módulo opcional oculta a função, mas mantém consultas e registros históricos.",
    "Toda gravação sensível tem chave de idempotência e confirmação de readback por estado de negócio.",
    "Várias linhas de um acerto devem usar transação de banco única; a implementação ainda não existe.",
    "Relatórios não devem causar mutações.",
    "Auditor e Bot são observadores; produção não depende de seu funcionamento.",
    "Cada módulo exige testes desktop e mobile, acessibilidade e validação em Safari/WebKit e Chrome.",
    "Nenhum contrato autoriza alterações no main, banco ou aplicação sem aprovação explícita."
  ],
  "commands": {
    "envelopeRequired": [
      "commandId",
      "moduleId",
      "kind",
      "actorId",
      "expectedRevision",
      "issuedAt",
      "payloadSchemaVersion",
      "payload"
    ],
    "lifeCycle": [
      "draft",
      "validated",
      "submitted",
      "acknowledged",
      "readback_confirmed",
      "conflicted",
      "uncertain",
      "rejected"
    ],
    "saveRules": {
      "idempotencyKey": "commandId",
      "atomic": true,
      "optimisticLock": "expectedRevision",
      "readback": "business-fields-with-revision",
      "replayOnTimeout": "never_without_reconciliation",
      "auditTrail": true
    },
    "safeDisable": {
      "preconditions": [
        "no_inflight_commands",
        "no_unconfirmed_wal_of_module",
        "allow_read_only_history"
      ],
      "failure": "block_disable_and_show_reason"
    },
    "botPermissions": [
      "read_technical_events",
      "propose_diagnostic",
      "generate_test_in_isolation",
      "prepare_pr_for_review"
    ],
    "auditorPermissions": [
      "read_technical_events",
      "inspect_consistency",
      "publish_read_only_findings"
    ]
  },
